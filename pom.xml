<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.anarchyphantoms</groupId>
    <artifactId>anarchy-phantoms</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>anarchy-phantoms</name>
    <description>Custom Phantom behavior: End-only spawning, endstone/chorus surface requirement, passive until attacked, silent screech until provoked.</description>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- Plan Player Analytics API, for the optional PlanHook / AnarchyPhantomsDataExtension integration. -->
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Centralized so CI and local `mvn test` always agree on which
          MockBukkit line is in use. MockBukkit's artifact is versioned
          per-Minecraft-major (mockbukkit-v1.21), so this must be bumped
          in lockstep with paper-api's major/minor above - see
          https://docs.mockbukkit.org for the current mapping table.
        -->
        <mockbukkit.version>4.16.0</mockbukkit.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.9-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!--
          Plan API - compile-time only (scope=provided means it's NOT bundled
          into the shaded/output jar and is expected to be supplied by the
          server's own Plan installation at runtime). See PlanHook.java for
          why every usage of these classes is isolated to one file, and
          plugin.yml's softdepend for the runtime-optional loading contract
          this dependency scope corresponds to.
        -->
        <dependency>
            <groupId>com.github.plan-player-analytics</groupId>
            <artifactId>Plan</artifactId>
            <!-- Check https://github.com/plan-player-analytics/Plan/releases for the latest build number before bumping. -->
            <version>5.8.3605</version>
            <scope>provided</scope>
        </dependency>

        <!--
          ================= TEST-ONLY DEPENDENCIES =================
          None of these are bundled into the shipped jar (scope=test).
          See src/test/java for what they're actually used for.
        -->

        <!-- JUnit 5: test engine + assertions. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          MockBukkit: spins up a real (in-memory, no networking/rendering)
          mock Bukkit/Paper server so tests can fire actual Bukkit events
          (CreatureSpawnEvent, EntityDamageByEntityEvent, etc.), spawn real
          mock entities, and assert on the resulting server/entity state -
          e.g. "was this CreatureSpawnEvent actually cancelled", not just
          "did the plugin jar load". This is what closes the gap this PR
          is about: the existing CI smoke-tests only prove the plugin
          enables without crashing; these tests prove the phantom
          spawn/aggro/silence RULES behave correctly.

          Versioned per-Minecraft-major (mockbukkit-v1.21) - bump alongside
          paper-api's version above, not independently.
        -->
        <dependency>
            <groupId>org.mockbukkit.mockbukkit</groupId>
            <artifactId>mockbukkit-v1.21</artifactId>
            <version>${mockbukkit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <!--
              Runs src/test/java against JUnit 5 (jupiter engine). These are
              plain `mvn test` unit/behavioral tests - separate from, and
              much faster than, the boot-a-real-server smoke tests in CI.
              defaultGoal above is "clean package", which itself runs the
              "test" phase first, so these already execute on every
              `mvn package` - this configuration just pins the surefire
              version and enables the JUnit 5 provider explicitly.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <trimStackTrace>false</trimStackTrace>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <!--
              Generates target/classes/git.properties at build time, embedding
              the current commit hash + build timestamp into the jar. Read at
              runtime by BuildInfo for the "/ap ver" command. Works both for
              local `mvn package` (as long as .git is present) and CI builds.
              If .git is missing (e.g. a source-only zip with no VCS history),
              failOnNoGitDirectory is false so the build still succeeds -
              BuildInfo falls back to "unknown" in that case.
            -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>9.0.1</version>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.commit.id\.(abbrev|full)$</includeOnlyProperty>
                        <includeOnlyProperty>^git.build.time$</includeOnlyProperty>
                        <includeOnlyProperty>^git.branch$</includeOnlyProperty>
                        <includeOnlyProperty>^git.dirty$</includeOnlyProperty>
                    </includeOnlyProperties>
                    <dateFormat>yyyy-MM-dd HH:mm:ss z</dateFormat>
                    <dateFormatTimeZone>UTC</dateFormatTimeZone>
                </configuration>
            </plugin>
            <!--
              Dumps the last MAX_GIT_HISTORY_ENTRIES commits (hash, epoch
              seconds, subject, body) into target/classes/git-history.properties
              at build time, embedding a static commit log into the jar. Read
              at runtime by GitHistory for "/ap git info <hash>" and
              "/ap git history". This is a *snapshot frozen at build time* -
              it cannot grow after the jar is built, and it only ever shows
              commits that existed in the .git directory the build ran in.

              REQUIRES a non-shallow checkout (fetch-depth >= 25, or 0 for
              full history) in CI - actions/checkout@v5 defaults to
              fetch-depth: 1, which would silently truncate this to a single
              commit. See .github/workflows/build.yml.

              Same fail-soft posture as git-commit-id-maven-plugin above: if
              git is missing or this is a source-only checkout with no .git,
              the script below writes an empty properties file rather than
              failing the build, and GitHistory falls back to "no history
              available" at runtime.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>export-git-history</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${project.basedir}/scripts/export-git-history.sh</argument>
                                <argument>${project.build.outputDirectory}/git-history.properties</argument>
                                <argument>25</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>